{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "capstoneadf456"
		},
		"adlslake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://capstoneadls456.dfs.core.windows.net"
		},
		"keyforall_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://capstonekey456.vault.azure.net/"
		},
		"sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "capstoneserver234.database.windows.net"
		},
		"sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "capstonedb"
		},
		"sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "capstoneadf456_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"keyforall_properties_typeProperties_baseUrl": {
						"value": "[parameters('keyforall_properties_typeProperties_baseUrl')]"
					},
					"adlslake_properties_typeProperties_url": {
						"value": "[parameters('adlslake_properties_typeProperties_url')]"
					},
					"sqldb_properties_typeProperties_server": {
						"value": "[parameters('sqldb_properties_typeProperties_server')]"
					},
					"sqldb_properties_typeProperties_database": {
						"value": "[parameters('sqldb_properties_typeProperties_database')]"
					},
					"sqldb_properties_typeProperties_userName": {
						"value": "[parameters('sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}